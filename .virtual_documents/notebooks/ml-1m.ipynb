import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
%matplotlib inline


unames = ['user_id', 'gender', 'age', 'occupation', 'zip']
users = pd.read_table('../datasets/ml-1m/users.dat', sep='::', header=None, names=unames, engine='python')


rnames = ['user_id', 'movie_id', 'rating', 'timestamp']
ratings = pd.read_table('../datasets/ml-1m/ratings.dat', sep='::', header=None, names=rnames, engine='python')


mnames = ['movie_id', 'title', 'genres']
movies = pd.read_table('../datasets/ml-1m/movies.dat', sep='::', header=None, names=mnames, engine='python')


users.head(10)


users.shape


users.describe()


users.info()


ratings.head(10)


ratings.shape


ratings[10:]


ratings[:10]


ratings.info()


ratings.describe()


movies.head(10)


movies.info()





# using pandas merge fn to merge  ratings with users then merging with the movies data
data = pd.merge(pd.merge(ratings, users), movies)
data.head()





data.info()


data.shape


data.iloc[0]


mean_ratings = data.pivot_table('rating', index='title', columns='gender', aggfunc='mean')
mean_ratings[:5]


mean_rating_s = pd.pivot_table(data, values='rating', index='title', columns='gender', aggfunc='mean')
mean_rating_s.head(10)





ratings_by_title = data.groupby('title').size()


ratings_by_title.head(10)


ratings_by_title.info()





active_titles=ratings_by_title.index[ratings_by_title >= 250]
active_titles





mean_ratings=mean_ratings.loc[active_titles]
mean_ratings





top_female_ratings=mean_ratings.sort_values(by='F', ascending=False)
top_female_ratings[:10]








mean_ratings['diff']=mean_ratings['M']-mean_ratings['F']
mean_ratings[:5]





sorted_by_diff=mean_ratings.sort_values(by='diff')
sorted_by_diff[:15]





sorted_by_diff.tail(15)





sorted_by_diff.sort_values(by='diff', ascending=False)[:15]








sorted_by_diff[::-1][:15]


rating_std_by_title=data.groupby('title')['rating'].std()
rating_std_by_title[:10]


rating_std_by_title=rating_std_by_title.loc[active_titles]
rating_std_by_title.head()


rating_std_by_title.sort_values(ascending=False)[:10]





import matplotlib.pyplot as plt
%matplotlib inline

sorted_by_diff.head(20).plot(kind='barh', y='diff', legend=False, color='deeppink')
plt.title('Top movies women rated higher than men')
plt.xlabel('Average rating difference(M-F)')
plt.ylabel('Movie title')
plt.tight_layout()
plt.show()


sorted_by_diff.tail(20).plot(kind='barh', y='diff', legend=False, color='orangered')
plt.title('Top Movies Men Rated Higher Than Women')
plt.xlabel('Average Rating Difference (M - F)')
plt.ylabel('Movie Title')
plt.tight_layout()
plt.show()
